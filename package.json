{
  "name": "frame-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:lint": "node scripts/verify-lint-rules.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm test:lint && pnpm lint:prettier && pnpm test:coverage",
    "test:package": "node scripts/verify-packages.mjs",
    "test:mutation": "node scripts/mutate.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:release": "pnpm check && pnpm test:mutation && pnpm test:package && pnpm verify:docs && pnpm verify:release"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@expo/ui": "57.0.21",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@use-voltra/ios": "2.4.0",
    "@use-voltra/ios-client": "2.4.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo": "57.0.26",
    "expo-widgets": "57.0.22",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-android-widget": "0.24.0",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.1.12"
  }
}
